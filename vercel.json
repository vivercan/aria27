{
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 60
    },
    "app/api/backup/snapshot/*.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/alertas/digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/backup/snapshot",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/health-monitor",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/monitoring/synthetic",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/backup/snapshot-heavy",
      "schedule": "0 10 * * 0"
    }
  ]
}